# ── Twitch application (https://dev.twitch.tv/console/apps) ─────────────────
# Register an app with OAuth redirect URL http://localhost:3000/auth/twitch/callback,
# category "Chat Bot", client type "Confidential". Never commit the real values.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# PUBLIC_URL=http://localhost:3000
# Set while running the Vite dev server so login returns to it:
# WEB_DEV_URL=http://localhost:5173
# Only these Twitch logins may sign in to the dashboard (comma separated, optional):
# ALLOWED_LOGINS=your_channel
# DATA_DIR=./data
# Generated and stored in DATA_DIR/secrets.json when unset:
# SESSION_SECRET=
# OVERLAY_KEY=
# AGENT_TOKEN=
# Secret path of the read-only co-host MCP URL (/mcp/cohost/COHOST_KEY):
# COHOST_KEY=
# Secret path of the streamer MCP URL for ChatGPT / Claude (/mcp/streamer/STREAMER_KEY):
# round control (open, vote, extend, close, hide, plan), never approval.
# STREAMER_KEY=
# Behind a TLS-terminating reverse proxy: set PUBLIC_URL=https://... and, if the
# proxy sets X-Forwarded-Proto, TRUST_PROXY=1 (never set it without a proxy).
# TRUST_PROXY=

# What is being built on stream — given to Aria when planning a winning idea.
PROJECT_BRIEF="A small browser game built live on stream."

# ── Planner: turns the winning idea into a task. Claude is used when
# ANTHROPIC_API_KEY is set, else an OpenAI-compatible model when OPENAI_API_KEY is
# set, else a labelled template plan. ARIA_LIVE_PLANNER=anthropic|openai|template forces one.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# ARIA_LIVE_PLANNER=
# OpenAI-compatible:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ARIA_LIVE_MODEL=gpt-5-mini

# ── Execution (runs only after the streamer approves, in a git worktree) ─────
# aria-code | codex | disabled
ARIA_LIVE_EXECUTOR=disabled
# Absolute path of the git repository being built on stream:
# TARGET_REPO=/path/to/your/game
# ARIA_CODE_BIN=aria-code
# CODEX_BIN=codex
# EXECUTION_TIMEOUT_SEC=900
# EXECUTOR_ALLOW_TOOLS=read_file,list_files,search_code,write_file,edit_file

# ── Local testing with the Twitch CLI mock EventSub server (twitch event websocket start-server)
# EVENTSUB_WS_URL=ws://127.0.0.1:8080/ws
# TWITCH_API_BASE=http://127.0.0.1:8080
